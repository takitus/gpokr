{
  "manifest_version": 3,
  "name": "GPokr Tools",
  "version": "1.1.0",
  "description": "Emotes, hand sharing, an odds HUD, and bet-sizing helpers for the GPokr table.",
  "permissions": ["storage"],
  "icons": {
	"16": "icons/icon16.png",
	"32": "icons/icon32.png",
	"48": "icons/icon48.png",
	"128": "icons/icon128.png"
  },
  "action": {
	"default_popup": "popup.html",
	"default_title": "GPokr Tools",
	"default_icon": {
	  "16": "icons/icon16.png",
	  "32": "icons/icon32.png",
	  "48": "icons/icon48.png",
	  "128": "icons/icon128.png"
	}
  },
  "content_scripts": [
	{
	  "matches": ["https://gpokr.com/*", "https://www.gpokr.com/*"],
	  "js": ["odds.js", "content.js"],
	  "css": ["overlay.css"],
	  "run_at": "document_idle"
	}
  ]
}
