{
  "manifest_version": 3,
  "name": "GPokr Tools",
  "version": "1.4.0",
  "description": "Dark mode, odds HUD, player stats & notes, bet-sizing buttons, session tracker, emotes, and hand sharing for GPokr.",
  "permissions": ["storage"],
  "icons": {
	"16": "icons/icon16.png",
	"32": "icons/icon32.png",
	"48": "icons/icon48.png",
	"128": "icons/icon128.png"
  },
  "action": {
	"default_popup": "popup.html",
	"default_title": "GPokr Tools",
	"default_icon": {
	  "16": "icons/icon16.png",
	  "32": "icons/icon32.png",
	  "48": "icons/icon48.png",
	  "128": "icons/icon128.png"
	}
  },
  "web_accessible_resources": [
	{
	  "resources": ["assets/table.png"],
	  "matches": ["https://gpokr.com/*", "https://www.gpokr.com/*"]
	}
  ],
  "content_scripts": [
	{
	  "matches": ["https://gpokr.com/*", "https://www.gpokr.com/*"],
	  "js": ["odds.js", "content.js"],
	  "css": ["overlay.css", "dark.css"],
	  "run_at": "document_idle"
	}
  ]
}
