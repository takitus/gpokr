{
  "manifest_version": 3,
  "name": "GPokr Tools",
  "version": "2.2.8",
  "description": "Dark mode, odds HUD, player stats & notes, table roster, bet sizing, session tracker, emotes, table interactions, and hand sharing.",
  "permissions": ["storage"],
  "icons": {
	"16": "icons/icon16.png",
	"32": "icons/icon32.png",
	"48": "icons/icon48.png",
	"128": "icons/icon128.png"
  },
  "action": {
	"default_popup": "popup.html",
	"default_title": "GPokr Tools",
	"default_icon": {
	  "16": "icons/icon16.png",
	  "32": "icons/icon32.png",
	  "48": "icons/icon48.png",
	  "128": "icons/icon128.png"
	}
  },
  "web_accessible_resources": [
	{
	  "resources": ["assets/*", "bridge/ws-monitor.js"],
	  "matches": ["https://gpokr.com/*", "https://www.gpokr.com/*", "https://kdice.com/*", "https://www.kdice.com/*"]
	}
  ],
  "content_scripts": [
	{
	  "matches": ["https://gpokr.com/*", "https://www.gpokr.com/*"],
	  "js": ["bridge/ws-monitor.js"],
	  "world": "MAIN",
	  "all_frames": true,
	  "match_about_blank": true,
	  "run_at": "document_start"
	},
	{
	  "matches": ["https://gpokr.com/*", "https://www.gpokr.com/*"],
	  "js": ["vendor/three.iife.js", "3d/chips3d.js", "3d/table3d.js", "3d/coin3d.js", "3d/props3d.js", "odds.js", "content.js"],
	  "css": ["overlay.css", "dark.css"],
	  "run_at": "document_idle"
	}
  ]
}
