{
	"manifest_version": 3,
	"name": "GPokr Tools",
	"version": "3.1.0",
	"description": "Hand summary, bets by street, custom bet buttons, quick chat, thrown props, celebrations and a 3D table for gpokr's new table.",
	"permissions": [
		"storage"
	],
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_popup": "popup-v3.html",
		"default_title": "GPokr Tools",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"web_accessible_resources": [
		{
			"resources": [
				"assets/*",
				"3d/*",
				"shim/*",
				"v3/*",
				"odds.js",
				"vendor/*"
			],
			"matches": [
				"https://gpokr.com/*",
				"https://www.gpokr.com/*"
			]
		}
	],
	"content_scripts": [
		{
			"matches": [
				"https://gpokr.com/*",
				"https://www.gpokr.com/*"
			],
			"js": [
				"content-v3.js"
			],
			"run_at": "document_idle"
		}
	]
}
